{
  // INFINEX 冊子
  // すべてのファイルを同じ場所に置く構成です（フォルダ不要）。
  // 画面のファイルはそのまま配信し、/api/ だけを worker.js で処理します。
  // 配信しないファイルは .assetsignore に書いています。
  "name": "infinex-booklet",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // 冊子の文章・構成を保存するデータベース
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "infinex-booklet-db",
      "database_id": "ff2ac8a9-6cdd-4661-97b6-d363f5194709"
    }
  ],
  // ロゴ・写真・表紙などの画像を保存する場所
  "kv_namespaces": [
    {
      "binding": "FILES",
      "id": "fd9c79178a334a58891e4cf936a078de"
    }
  ],
  "observability": { "enabled": true }
}
